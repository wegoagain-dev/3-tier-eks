# Flask Configuration
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=generate-a-real-key-for-production

# Database Configuration
# For local dev (no docker): localhost
# For local docker: host.docker.internal
# For k8s: postgres-db (service name)
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=devops_learning

# The URL used by SQLAlchemy
# Note: config.py will construct this automatically from the variables above.
# You only need to uncomment this if you want to override the automatic construction.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/devops_learning

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000
