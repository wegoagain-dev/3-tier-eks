# Flask Configuration
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=generate-a-real-key-for-production

# Database Configuration
# This single URL is used by the application to connect to the database.
# 
# For local development with docker-compose (recommended):
DATABASE_URL=postgresql://postgres:password@db:5432/devops_learning
# 
# For local development without docker-compose:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/devops_learning
#
# For Kubernetes (Kind or EKS):
# DATABASE_URL is provided via Kubernetes secrets (see .env.k8s.example for Kind)

# Database Password (used separately in some configurations)
DB_PASSWORD=password

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

